rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'm.h.ratul18@gmail.com';
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Products Collection (Storefront items)
    // Public read so all visitors can browse the catalog
    // Admin only write/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }

    // 2. Coupons Collection (Promo codes)
    // Public read for discount validation
    // Admin only management
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }

    // 3. Admin Team Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }

    // 4. Users Collection (Customer profiles)
    // Authenticated users and admins can read/write
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // 5. Orders Collection
    // Customers can submit orders with their TrxID; admins can approve and deliver
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // 6. Subscriptions Collection (Vault credentials & active plans)
    // Synchronized credentials and active plans
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // 7. Support Tickets Collection
    // Real-time live messaging and customer ticketing
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // 8. Reviews Collection (Customer Ratings & Reviews)
    // Public read and verified customer submissions
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // 9. Payment Methods Collection (bKash, Nagad, Rocket numbers & QR codes)
    // Public read for checkout payment display
    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }

    // 10. Hero Slides Collection (Storefront Dynamic Banner Management)
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }

    // 11. Email Verifications & OTPs
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // 12. Quick Messages & Bot Auto-Replies
    match /quick_messages/{messageId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin() || isAuthenticated();
    }
  }
}

