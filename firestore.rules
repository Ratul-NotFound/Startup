rules_version = '2';

// ============================================================================
// 🔒 SUBNEXUS FIRESTORE SECURITY & ACCESS RULES
// ============================================================================
// Development Mode: Unrestricted read/write across all collections for seamless
// prototyping, demo simulations, and real-time syncing.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // 🛠️ HELPER FUNCTIONS
    // ────────────────────────────────────────────────────────────────────────

    // Checks if the request is coming from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the authenticated user is the primary Superadmin / Owner
    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'm.h.ratul18@gmail.com';
    }

    // Checks if the user has an Admin role in the users collection or is Superadmin
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_'))))
      );
    }

    // ────────────────────────────────────────────────────────────────────────
    // 🔓 1. PUBLIC STOREFRONT DATA (Read/Write accessible for live sync)
    // ────────────────────────────────────────────────────────────────────────

    // Products Catalog (Storefront digital plans & specifications)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Coupons & Special Offers (Promo codes, giveaways & flash deals)
    match /coupons/{couponCode} {
      allow read, write: if true;
    }

    // Customer Reviews & Ratings (Verified buyer feedback & star ratings)
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Bangladesh Payment Gateways (bKash, Nagad, Rocket, Upay numbers & QR codes)
    match /payment_methods/{methodId} {
      allow read, write: if true;
    }

    // Storefront Hero Carousel Slides (Dynamic homepage banner slides)
    match /hero_slides/{slideId} {
      allow read, write: if true;
    }

    // Quick Bot Messages & Auto-Replies (Chatbot prompt chips & answers)
    match /quick_messages/{messageId} {
      allow read, write: if true;
    }

    // ────────────────────────────────────────────────────────────────────────
    // 🔐 2. CUSTOMER & ORDER OPERATIONS (Synced live to customer vault)
    // ────────────────────────────────────────────────────────────────────────

    // Customer Profiles (User account info, lifetime spend & roles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customer Orders (TrxID payment submissions & delivery status)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Vault Subscriptions & Logins (Provisioned account credentials & expiry dates)
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Support Queue & Direct Messages (Customer tickets & admin replies)
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Email Verifications & OTP Tokens
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // ────────────────────────────────────────────────────────────────────────
    // 🛡️ 3. ADMIN MANAGEMENT
    // ────────────────────────────────────────────────────────────────────────

    // Admin Team List (Access control list for command hub)
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Admin Activity Audit Trace Logs
    match /admin_activity_logs/{logId} {
      allow read, write: if true;
    }
  }
}
