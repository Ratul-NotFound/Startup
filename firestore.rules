rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'm.h.ratul18@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower().replace('[^a-z0-9]', '_')))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Products Collection (Storefront items)
    // Public read so all visitors can browse the catalog
    // Admin only write/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // 2. Coupons Collection (Promo codes)
    // Public read for discount validation
    // Admin only management
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // 3. Admin Team Collection
    // Authenticated users can check admin status
    // Only Superadmin / existing admins can add/remove admins
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // 4. Users Collection (Customer profiles)
    // Users can read/write their own profile
    // Admins can view all users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // 5. Orders Collection
    // Users can create and read their own orders
    // Admins can read, update status, and manage all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // 6. Subscriptions Collection (Vault credentials & active plans)
    // Users can read their own subscriptions
    // Admins can read, assign credentials, and manage all subscriptions
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // 7. Support Tickets Collection
    // Users can read/create/reply to their own tickets
    // Admins can read and reply to all tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // 8. Reviews Collection (Customer Ratings & Reviews)
    // Public read so all visitors can see authentic verified reviews
    // Authenticated users can create reviews and toggle likes
    // Review authors or Admins can delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 9. Payment Methods Collection (Bangladesh bKash, Nagad, Rocket numbers & QR codes)
    // Public read for checkout payment display
    // Admin only create/update/delete
    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }
  }
}


